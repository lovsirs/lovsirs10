local function asColor3(c)
    if typeof(c) == "Color3" then return c end
    if typeof(c) == "Instance" and c:IsA("Color3Value") then return c.Value end
    if type(c) == "table" then
        if typeof(c.Color) == "Color3" then return c.Color end
        if typeof(c.Value) == "Color3" then return c.Value end
        if c.R and c.G and c.B then
            local r, g, b = c.R, c.G, c.B
            if r > 1 or g > 1 or b > 1 then return Color3.fromRGB(r, g, b) end
            return Color3.new(r, g, b)
        end
        if c[1] and c[2] and c[3] then
            local r,g,b = c[1], c[2], c[3]
            if r > 1 or g > 1 or b > 1 then return Color3.fromRGB(r, g, b) end
            return Color3.new(r, g, b)
        end
    end
    if type(c) == "string" then
        local ok, col = pcall(function() return Color3.fromHex(c) end)
        if ok and col then return col end
    end
    return nil
end

