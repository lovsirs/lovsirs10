local function applyWeatherStyle(emitter, style, amount, color)
    emitter.Enabled = true
    emitter.Color = ColorSequence.new(color)
    emitter.EmissionDirection = Enum.NormalId.Bottom
    emitter.LightInfluence = 0.5
    if style == "rain" then
        emitter.Texture = WeatherTextures.rain
        emitter.Rate = math.clamp(amount * 2, 50, 8000)
        emitter.Speed = NumberRange.new(50, 80)
        emitter.Lifetime = NumberRange.new(0.6, 1.0)
        emitter.Size = NumberSequence.new(8, 10)
        emitter.Transparency = NumberSequence.new(0.2, 0.8)
        emitter.SpreadAngle = Vector2.new(8, 8)
        emitter.Acceleration = Vector3.new(0, -40, 0)
        emitter.LockedToPart = true
        emitter.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
    elseif style == "lightrain" then
        emitter.Texture = WeatherTextures.lightrain
        emitter.Rate = math.clamp(amount, 30, 3000)
        emitter.Speed = NumberRange.new(30, 50)
        emitter.Lifetime = NumberRange.new(1.2, 2)
        emitter.Size = NumberSequence.new(0.2, 0.35)
        emitter.Transparency = NumberSequence.new(0.1, 0.7)
        emitter.SpreadAngle = Vector2.new(12, 12)
        emitter.Acceleration = Vector3.new(0, -20, 0)
        emitter.LockedToPart = true
        emitter.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
    elseif style == "snow" then
        emitter.Texture = WeatherTextures.snow
        emitter.Rate = math.clamp(amount, 20, 3000)
        emitter.Speed = NumberRange.new(6, 14)
        emitter.Lifetime = NumberRange.new(4, 7)
        emitter.Size = NumberSequence.new(0.3, 0.55)
        emitter.Transparency = NumberSequence.new(0.15, 0.85)
        emitter.SpreadAngle = Vector2.new(40, 40)
        emitter.Acceleration = Vector3.new(0, -4, 0)
        emitter.LockedToPart = false
        emitter.Orientation = Enum.ParticleOrientation.FacingCamera
    elseif style == "autumn" then
        emitter.Texture = WeatherTextures.autumn
        emitter.Rate = math.clamp(amount, 20, 2500)
        emitter.Speed = NumberRange.new(8, 20)
        emitter.Lifetime = NumberRange.new(2.5, 5)
        emitter.Size = NumberSequence.new(0.5, 1.1)
        emitter.Transparency = NumberSequence.new(0.1, 0.7)
        emitter.SpreadAngle = Vector2.new(50, 50)
        emitter.Acceleration = Vector3.new(0, -7, 0)
        emitter.LockedToPart = false
        emitter.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
    else
        emitter.Texture = WeatherTextures.stars
        emitter.Rate = math.clamp(amount, 20, 2000)
        emitter.Speed = NumberRange.new(5, 15)
        emitter.Lifetime = NumberRange.new(2, 4)
        emitter.Size = NumberSequence.new(0.15, 0.4)
        emitter.Transparency = NumberSequence.new(0.1, 0.9)
        emitter.SpreadAngle = Vector2.new(55, 55)
        emitter.Acceleration = Vector3.new(0, -2, 0)
        emitter.LockedToPart = false
        emitter.Orientation = Enum.ParticleOrientation.FacingCamera
        emitter.LightEmission = 0.8
    end
end

local function startWeather()
    clearWeather()
    local part = Instance.new("Part")
    part.Name = "void_weather_part"
    part.Size = Vector3.new(60, 1, 60)
    part.Transparency = 1
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Parent = Workspace

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "void_weather_emitter"
    emitter.Parent = part
    applyWeatherStyle(emitter, currentWeather, weatherAmount, weatherColor)

    weatherPart = part
    weatherEmitter = emitter

    weatherConn = RunService.RenderStepped:Connect(function()
        if weatherPart and weatherPart.Parent then
            local pos = Camera.CFrame.Position + Vector3.new(0, 25, 0)
            weatherPart.CFrame = CFrame.new(pos)
        end
        if weatherEmitter and weatherEmitter.Parent and weatherEnabled then
            if not weatherEmitter.Enabled then
                weatherEmitter.Enabled = true
            end
        end
    end)
end

local function stopWeather()
    clearWeather()
end

local function restartWeather()
    if weatherEnabled then
        startWeather()
    else
        stopWeather()
    end
end

local ambientSounds = {
    ["none"] = nil,
    ["rain"] = 132717551555191,
    ["snow storm"] = 551546110,
    ["night"] = 125710682931536,
    ["birds"] = 9112831327,
    ["crickets"] = 9112764040,
    ["campfire"] = 109494611784143,
}

local curambientsound = nil
local ambientSoundOn = false
local ambientSoundType = "rain"
local ambientSoundVol = 5

local function stopAmbientSound()
    if curambientsound then
        pcall(function()
            curambientsound:Stop()
            curambientsound:Destroy()
        end)
        curambientsound = nil
    end
end

local function playAmbientSound(name, volume)
    stopAmbientSound()
    local id = ambientSounds[name]
    if not id then return end
    curambientsound = Instance.new("Sound")
    curambientsound.Name = "void_ambient"
    curambientsound.SoundId = "rbxassetid://" .. tostring(id)
    curambientsound.Looped = true
    curambientsound.Volume = volume or 5
    curambientsound.Parent = SoundService
    curambientsound:Play()
end

