local function getPredictedPos(part, prediction)
    local pos = part.Position
    local parent = part.Parent
    local root = parent and parent:FindFirstChild("HumanoidRootPart")
    local vel = Vector3.zero
    if root then
        vel = root.AssemblyLinearVelocity
    elseif part.AssemblyLinearVelocity then
        vel = part.AssemblyLinearVelocity
    end
    return pos + vel * prediction
end

