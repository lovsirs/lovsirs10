local function makeBulletTracer(startPos, endPos)
    if not bulletTracer.enabled then return end
    if not startPos or not endPos then return end

    local a0 = Instance.new("Attachment")
    a0.WorldPosition = startPos
    a0.Parent = Workspace.Terrain

    local a1 = Instance.new("Attachment")
    a1.WorldPosition = endPos
    a1.Parent = Workspace.Terrain

    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.Color = ColorSequence.new(bulletTracer.color)
    beam.Width0 = 0.08 * bulletTracer.size
    beam.Width1 = 0.04 * bulletTracer.size
    beam.FaceCamera = true
    beam.LightEmission = bulletTracer.glow
    beam.LightInfluence = 0.2
    beam.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.7, 0.15),
        NumberSequenceKeypoint.new(1, 0.55)
    })
    beam.Parent = Workspace.Terrain

    table.insert(bulletTracers, {
        beam = beam,
        a0 = a0,
        a1 = a1,
        created = tick(),
        lifetime = bulletTracer.duration,
        fade = bulletTracer.fadeTime
    })
end

local function updateBulletTracers()
    local now = tick()
    for i = #bulletTracers, 1, -1 do
        local tr = bulletTracers[i]
        local age = now - tr.created
        if age >= tr.lifetime then
            pcall(function()
                if tr.beam then tr.beam:Destroy() end
                if tr.a0 then tr.a0:Destroy() end
                if tr.a1 then tr.a1:Destroy() end
            end)
            table.remove(bulletTracers, i)
        elseif age >= (tr.lifetime - tr.fade) then
            local t = (age - (tr.lifetime - tr.fade)) / math.max(tr.fade, 0.01)
            local alpha = math.clamp(t, 0, 1)
            if tr.beam then
                tr.beam.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, alpha),
                    NumberSequenceKeypoint.new(1, math.clamp(alpha + 0.4, 0, 1))
                })
            end
        end
    end
end

