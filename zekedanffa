RunService:BindToRenderStep("void_camlock", Enum.RenderPriority.Camera.Value + 1, function()
    if not Cam.enabled or not Cam.lockedTarget then return end

    local camTgt = Cam.lockedTarget
    if not camTgt or not camTgt.Parent then
        Cam.lockedTarget = nil
        return
    end
    local char = camTgt.Character
    if not char or not char.Parent then
        Cam.lockedTarget = nil
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        Cam.lockedTarget = nil
        return
    end
    local state = char:FindFirstChild("State")
    if state then
        local down, dead = state:FindFirstChild("Down"), state:FindFirstChild("Dead")
        if (down and down.Value) or (dead and dead.Value) then
            Cam.lockedTarget = nil
            return
        end
    end

    local part = char:FindFirstChild(Cam.hit) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if not part then
        Cam.lockedTarget = nil
        return
    end

    local aimPos = getPredictedPos(part, Cam.prediction)

    if Cam.shaky then
        local a = Cam.shakyAmount
        aimPos = aimPos + Vector3.new(
            math.noise(tick() * 8, 1.2) * a,
            math.noise(2.1, tick() * 8) * a,
            math.noise(tick() * 5, tick() * 3) * a
        )
    end

    local camPos = Camera.CFrame.Position
    local targetCF = CFrame.new(camPos, aimPos)
    local lerpAlpha = math.clamp(1 - Cam.smoothness, 0.08, 1)
    Camera.CFrame = Camera.CFrame:Lerp(targetCF, lerpAlpha)
end)

